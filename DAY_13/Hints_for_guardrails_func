    return False, question_embedding


# SAVE CACHE

def save_query_cache(question,
                     embedding,
                     answer):

    QUERY_CACHE.append({
        "question": question,
        "embedding": embedding,
        "answer": answer
    })

# PII DETECTION
EMAIL_PATTERN = r"\S+@\S+\.\S+"
PHONE_PATTERN = r"\b\d{10}\b"
AADHAR_PATTERN = r"\b\d{4}\s?\d{4}\s?\d{4}\b"
PAN_PATTERN = r"\b[A-Z]{5}[0-9]{4}[A-Z]\b"

def mask_pii(question):

    question = re.sub(
        EMAIL_PATTERN,
        "[EMAIL]",
        question
    )

    question = re.sub(
        PHONE_PATTERN,
        "[PHONE]",
        question
    )

    question = re.sub(
        AADHAR_PATTERN,
        "[AADHAR]",
        question
    )

    question = re.sub(
        PAN_PATTERN,
        "[PAN]",
        question
    )

    return True, question
