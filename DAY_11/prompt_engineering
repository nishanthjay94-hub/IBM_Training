from langchain.prompts import PromptTemplate

# -----------------------------
# Prompt Engineering Selection
# -----------------------------

prompt_type = st.selectbox(
    "Select Prompt Engineering Technique",
    [
        "Zero Shot",
        "One Shot",
        "Few Shot",
        "Role Prompting",
        "Instruction Prompting"
    ]
)

# =====================================
# Prompt Templates
# =====================================

# 1. Zero Shot Prompt

zero_prompt = PromptTemplate(
    input_variables=["context", "question"],
    template="""
You are a helpful AI assistant.

Answer the question ONLY using the given context.

Context:
{context}

Question:
{question}

Answer:
"""
)


# 2. One Shot Prompt

one_prompt = PromptTemplate(
    input_variables=["context", "question"],
    template="""
Example

Question:
What is Annual Leave?

Answer:
Employees receive 24 annual leave days.

------------------------------------

Context:
{context}

Question:
{question}

Answer:
"""
)


# 3. Few Shot Prompt

few_prompt = PromptTemplate(
    input_variables=["context", "question"],
    template="""
Example 1

Question:
What is Annual Leave?

Answer:
Employees receive 24 annual leave days.

------------------------------------

Example 2

Question:
Can employees work remotely?

Answer:
Employees may work remotely two days per week.

------------------------------------

Context:
{context}

Question:
{question}

Answer:
"""
)


# 4. Role Prompting

role_prompt = PromptTemplate(
    input_variables=["context", "question"],
    template="""
You are an experienced HR Manager with over 20 years of experience.

Your responsibilities are

- Explain company policies professionally.
- Use simple language.
- Mention page numbers if possible.

Context:
{context}

Question:
{question}

Answer:
"""
)


# 5. Instruction Prompting

instruction_prompt = PromptTemplate(
    input_variables=["context", "question"],
    template="""
Instructions

1. Use ONLY the provided context.

2. Never use outside knowledge.

3. Never hallucinate.

4. If the answer is unavailable, say

"I could not find the answer in the document."

5. Mention the page number whenever possible.

6. Keep the answer within 150 words.

Context:
{context}

Question:
{question}

Answer:
"""
)

# =====================================
# Select Prompt
# =====================================

if prompt_type == "Zero Shot":

    selected_prompt = zero_prompt

elif prompt_type == "One Shot":

    selected_prompt = one_prompt

elif prompt_type == "Few Shot":

    selected_prompt = few_prompt

elif prompt_type == "Role Prompting":

    selected_prompt = role_prompt

else:

    selected_prompt = instruction_prompt

#Modify RetrievalQA
    qa = RetrievalQA.from_chain_type(

    llm=llm,

    chain_type="stuff",

    retriever=retriever,

    chain_type_kwargs={
        "prompt": selected_prompt
    }

)